provider "azurerm" {
  features {}
}

resource "azurerm_resource_group" "RG" {
  name     = "RG1"
  location = "East-US"
}

resource "azurerm_resource_group" "RG1" {
  name     = "rg-hyperv-storage"
  location = "East-US"
}

# Optional: Fetch the existing VNet (useful if you need its location or address space)
data "azurerm_virtual_network" "NG" {
  name                = "On-Prem-vnet"
  resource_group_name = "RG1"
}

# Required: Fetch the existing Subnet
data "azurerm_subnet" "onprem-subnet1" {
  name                 = "subnet1-onprem-vnet"
  virtual_network_name = data.azurerm_virtual_network.NG.name # or hardcode "my-existing-vnet"
  resource_group_name  = "RG1"


resource "azurerm_network_interface" "NIC" {
  name                = "NIC1"
  location            = azurerm_resource_group.RG.location
  resource_group_name = azurerm_resource_group.RG.name
  ip_forwarding_enabled = true # Enables Azure IP forwarding on the NIC

# 1. Declare the Public IP as its own resource
resource "azurerm_public_ip" "public" {
  name                = "pub-pip"
  resource_group_name = azurerm_resource_group.RG.name
  location            = azurerm_resource_group.RG.location
  allocation_method   = "Static" # Standard SKU requires Static
  sku                 = "Standard"
}

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.onprem-subnet1.id
    private_ip_address_allocation = "10.0.1.4"
  }
# 2. The Public IP (Optional, maps directly to the Private IP above)
    public_ip_address_id          = azurerm_public_ip.example.id {
  }
}

resource "azurerm_windows_virtual_machine" "VM" {
  name                = "VM-HV-001"
  resource_group_name = azurerm_resource_group.RG.name
  location            = azurerm_resource_group.RG.location
  size                = "Standard_E8ds_v5"
  admin_username      = "adminuser"
  admin_password      = "P@$$w0rd1234!"
  network_interface_ids = [
    azurerm_network_interface.NIC.id,
  ]
  # 2. Declare that this is a Spot VM
  priority        = "Spot" 
  eviction_policy = "Deallocate" # Options: "Deallocate" or "Delete"
  max_bid_price   = -1           # Optional: -1 means pay up to the standard on-demand price

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }
# 1. Create the 64 GB Managed Disk (eligible under Azure's free 2x 64 GB tier)
resource "azurerm_managed_disk" "vhdx_disk" {
  name                 = "hyperv-baseline-disk"
  location             = azurerm_resource_group.RG1.location
  resource_group_name  = azurerm_resource_group.RG1.name
  storage_account_type = "StandardSSD_LRS" # Standard SSD (E6) is covered by the free tier
  create_option        = "Empty"
  disk_size_gb         = 64
  
lifecycle {
    prevent_destroy = true
  }
}

source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2025-Datacenter"
    version   = "latest"
  }
  resource "azurerm_virtual_machine_extension" "hyperv_full_setup" {
  name                 = "hyperv-full-setup"
  virtual_machine_id   = azurerm_windows_virtual_machine.VM.id
  publisher            = "Microsoft.Compute"
  type                 = "CustomScriptExtension"
  type_handler_version = "1.10"

  # Ensure the 64 GB disk is attached before the script runs
  depends_on = [
    azurerm_virtual_machine_data_disk_attachment.vhdx_disk_attach
  ]

  settings = jsonencode({
    "commandToExecute" = <<-EOT
      powershell -ExecutionPolicy Unrestricted -Command "
        # 1. Enable IP forwarding on the Azure NIC (10.0.1.4)
        $azIf = Get-NetAdapter | Where-Object { (Get-NetIPAddress -InterfaceIndex $_.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue).IPAddress -eq '10.0.1.4' };
        if ($azIf) { Set-NetIPInterface -InterfaceIndex $azIf.ifIndex -Forwarding Enabled };

        # 2. Build the Post-Reboot PowerShell script
        $postScript = @'
        # A. Safely initialize the 64 GB disk ONLY if it is RAW (never wipes existing VHDX data)
        $rawDisk = Get-Disk | Where-Object { $_.PartitionStyle -eq 'RAW' -and $_.Size -gt 50GB };
        if ($rawDisk) {
          $rawDisk | Initialize-Disk -PartitionStyle GPT -PassThru |
            New-Partition -DriveLetter F -UseMaximumSize |
            Format-Volume -FileSystem NTFS -NewFileSystemLabel 'HyperVBase' -Confirm:$false
        } else {
          # If already formatted from a previous Spot VM, ensure it is online and mounted as F:
          $existingDisk = Get-Disk | Where-Object { $_.OperationalStatus -eq 'Offline' };
          if ($existingDisk) { $existingDisk | Set-Disk -IsOffline $false }
        }

        # B. Create Hyper-V Internal Switch (if it does not exist yet)
        if (-not (Get-VMSwitch -Name 'InternalSwitch' -ErrorAction SilentlyContinue)) {
          New-VMSwitch -Name 'InternalSwitch' -SwitchType Internal
        }

        # C. Assign Gateway IP (192.168.100.1/24) matching your Azure UDR and enable forwarding
        $vSwitchIf = Get-NetAdapter | Where-Object { $_.Name -like '*InternalSwitch*' };
        if ($vSwitchIf) {
          New-NetIPAddress -InterfaceIndex $vSwitchIf.ifIndex -IPAddress '192.168.100.1' -PrefixLength 24 -ErrorAction SilentlyContinue;
          Set-NetIPInterface -InterfaceIndex $vSwitchIf.ifIndex -Forwarding Enabled
        }

        # D. Clean up the one-time scheduled task
        Unregister-ScheduledTask -TaskName 'PostHyperVSetup' -Confirm:$false
'@;
        Set-Content -Path 'C:\PostHyperVSetup.ps1' -Value $postScript;

        # 3. Register the task to run once at startup after Hyper-V reboots
        $action = New-ScheduledTaskAction -Execute 'PowerShell.exe' -Argument '-ExecutionPolicy Unrestricted -File C:\PostHyperVSetup.ps1';
        $trigger = New-ScheduledTaskTrigger -AtStartup;
        Register-ScheduledTask -TaskName 'PostHyperVSetup' -Action $action -Trigger $trigger -User 'SYSTEM' -RunLevel Highest -Force;

        # 4. Install Hyper-V and trigger reboot
        Install-WindowsFeature -Name Hyper-V -IncludeManagementTools -Restart
      "
    EOT
  })
}

}
