provider "azurerm" {
  features {}
}

resource "azurerm_resource_group" "RG" {
  name     = "RG1"
  location = "East-US"
}

# Optional: Fetch the existing VNet (useful if you need its location or address space)
data "azurerm_virtual_network" "NG" {
  name                = "On-Prem-vnet"
  resource_group_name = "RG1"
}

# Required: Fetch the existing Subnet
data "azurerm_subnet" "onprem-subnet1" {
  name                 = "subnet1-onprem-vnet"
  virtual_network_name = data.azurerm_virtual_network.NG.name # or hardcode "my-existing-vnet"
  resource_group_name  = "RG1"


resource "azurerm_network_interface" "NIC" {
  name                = "NIC1"
  location            = azurerm_resource_group.RG.location
  resource_group_name = azurerm_resource_group.RG.name
  ip_forwarding_enabled = true # Enables Azure IP forwarding on the NIC

# 1. Declare the Public IP as its own resource
resource "azurerm_public_ip" "public" {
  name                = "pub-pip"
  resource_group_name = azurerm_resource_group.RG.name
  location            = azurerm_resource_group.RG.location
  allocation_method   = "Static" # Standard SKU requires Static
  sku                 = "Standard"
}

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.onprem-subnet1.id
    private_ip_address_allocation = "10.0.1.4"
  }
# 2. The Public IP (Optional, maps directly to the Private IP above)
    public_ip_address_id          = azurerm_public_ip.example.id {
  }
}

resource "azurerm_windows_virtual_machine" "VM" {
  name                = "VM-HV-001"
  resource_group_name = azurerm_resource_group.RG.name
  location            = azurerm_resource_group.RG.location
  size                = "Standard_E8ds_v5"
  admin_username      = "adminuser"
  admin_password      = "P@$$w0rd1234!"
  network_interface_ids = [
    azurerm_network_interface.NIC.id,
  ]
  # 2. Declare that this is a Spot VM
  priority        = "Spot" 
  eviction_policy = "Deallocate" # Options: "Deallocate" or "Delete"
  max_bid_price   = -1           # Optional: -1 means pay up to the standard on-demand price

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }
# 1. Create the 64 GB Managed Disk (eligible under Azure's free 2x 64 GB tier)
resource "azurerm_managed_disk" "vhdx_disk" {
  name                 = "hyperv-baseline-disk"
  location             = azurerm_resource_group.RG.location
  resource_group_name  = azurerm_resource_group.RG.name
  storage_account_type = "StandardSSD_LRS" # Standard SSD (E6) is covered by the free tier
  create_option        = "Empty"
  disk_size_gb         = 64
}

# 2. Explicitly attach the Managed Disk to your Spot VM
resource "azurerm_virtual_machine_data_disk_attachment" "vhdx_disk_attach" {
  managed_disk_id    = azurerm_managed_disk.vhdx_disk.id
  virtual_machine_id = azurerm_windows_virtual_machine.VM.id
  lun                = 0
  caching            = "ReadWrite"
}


  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2025-Datacenter"
    version   = "latest"
  }
  resource "azurerm_virtual_machine_extension" "install_hyperv" {
  name                 = "install-hyperv"
  virtual_machine_id   = azurerm_windows_virtual_machine.VM.id
  publisher            = "Microsoft.Compute"
  type                 = "CustomScriptExtension"
  type_handler_version = "1.10"

  settings = jsonencode({
    "commandToExecute" = "powershell -ExecutionPolicy Unrestricted -Command \"Install-WindowsFeature -Name Hyper-V -IncludeManagementTools -Restart\""
  })
}
}
