# Inside Folder 2 (02-spot-hyperv-vm/main.tf)
# Looks up the existing 64 GB disk without managing or destroying it
data "azurerm_managed_disk" "vhdx_disk" {
  name                = "hyperv-baseline-disk"
  resource_group_name = "rg-hyperv-storage"
}

resource "azurerm_virtual_machine_data_disk_attachment" "vhdx_disk_attach" {
  managed_disk_id    = data.azurerm_managed_disk.vhdx_disk.id
  virtual_machine_id = azurerm_windows_virtual_machine.example.id
  lun                = 0
  caching            = "ReadWrite"
}

