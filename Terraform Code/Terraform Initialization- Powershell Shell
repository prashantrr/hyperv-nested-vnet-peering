Automate Dev and Prod Subscription Switching

Test-Path $PROFILE
New-Item -Path $PROFILE -ItemType File -Force  (If above command false create it )
notepad $PROFILE   (Open the Profile ) and below configuration in profile file 



# Azure Subscription Configuration

$DEV_SUBSCRIPTION_ID  = "YOUR-DEV-SUBSCRIPTION-ID"
$PROD_SUBSCRIPTION_ID = "YOUR-PROD-SUBSCRIPTION-ID"


# Switch to DEV
function Switch-Dev {

    az account set --subscription $DEV_SUBSCRIPTION_ID

    if ($LASTEXITCODE -ne 0) {
        Write-Host "DEV subscription selection failed" -ForegroundColor Red
        return
    }

    $env:ARM_SUBSCRIPTION_ID = $DEV_SUBSCRIPTION_ID

    Write-Host "Switched to DEV" -ForegroundColor Green

    az account show --query "{Name:name, Subscription:id}" -o table
}


# Switch to PROD
function Switch-Prod {

    az account set --subscription $PROD_SUBSCRIPTION_ID

    if ($LASTEXITCODE -ne 0) {
        Write-Host "PROD subscription selection failed" -ForegroundColor Red
        return
    }

    $env:ARM_SUBSCRIPTION_ID = $PROD_SUBSCRIPTION_ID

    Write-Host "Switched to PROD" -ForegroundColor Yellow

    az account show --query "{Name:name, Subscription:id}" -o table
}

. $PROFILE  (Load the Profile )

Now Switch the Profile using 

