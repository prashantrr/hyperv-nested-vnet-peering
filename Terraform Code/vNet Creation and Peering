resource "azurerm_resource_group" "RG" {
  name     = "RG1"
  location = "East-US"
}

resource "azurerm_virtual_network" "NG" {
  name                = "On-Prem-vnet"
  location            = azurerm_resource_group.RG.location
  resource_group_name = azurerm_resource_group.RG.name
  address_space       = ["10.0.0.0/16"]
 # dns_servers         = []

  subnet {
    name             = "subnet1-onprem-vnet"
    address_prefixes = ["10.0.1.0/24"]
  }

resource "azurerm_virtual_network" "NG1" {
  name                = "hub-vnet"
  location            = azurerm_resource_group.RG.location
  resource_group_name = azurerm_resource_group.RG.name
  address_space       = ["10.10.0.0/16"]
 # dns_servers         = []

  subnet {
    name             = "subnet1-hub-vnet"
    address_prefixes = ["10.0.1.0/24"]
  }


#Vnet Peering
resource "azurerm_virtual_network_peering" "Peer1" {
  name                      = "On-Prem to hub-vnet"
  resource_group_name       = azurerm_resource_group.RG.name
  virtual_network_name      = azurerm_virtual_network.NG.name
  remote_virtual_network_id = azurerm_virtual_network.NG1.id
  allow_forwarded_traffic   = true
}

resource "azurerm_virtual_network_peering" "example-2" {
  name                      = "hub-vnet t0 On-Prem"
  resource_group_name       = azurerm_resource_group.RG.name
  virtual_network_name      = azurerm_virtual_network.NG2.name
  remote_virtual_network_id = azurerm_virtual_network.NG1.id
  allow_forwarded_traffic   = true
}

# 1. Create the Route Table with a User-Defined Route (UDR)
resource "azurerm_route_table" "udr" {
  name                = "hyperv-udr-table"
  location            = azurerm_resource_group.RG.location
  resource_group_name = azurerm_resource_group.RG.name

  route {
    name                   = "route-to-hyperv-vms"
    address_prefix         = "192.168.100.0/24"     # Replace with your nested Hyper-V subnet CIDR
    next_hop_type          = "VirtualAppliance"
    next_hop_in_ip_address = "10.0.1.4"             # Private IP of your Windows Hyper-V host NIC
  }
}

# 2. Attach the Route Table to your Subnet
resource "azurerm_subnet_route_table_association" "route1" {
  subnet_id      = azurerm_subnet.subnet1-onprem-vnet.id
  route_table_id = azurerm_route_table.route1.id
}

